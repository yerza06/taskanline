# Конфигурация TasKanLine. Скопировать рядом как .env и заполнить: cp .env.example .env
# Все переменные разбирает pydantic-settings (backend/app/core/config.py).
#
# Настройки сгруппированы по областям, и группа задаёт префикс: DB__, SECURITY__,
# APP__, CORS__, SERVER__, LOG__. Разделитель — два подчёркивания.

# --- База данных (обязательна) ---

# Драйвер: только асинхронный, иначе весь async-слой ломается молча.
DB__DRIVER=postgresql+asyncpg
DB__USER=taskanline
DB__PASSWORD=taskanline
# В docker-compose хост — имя сервиса: postgres
DB__HOST=localhost
DB__PORT=5432
DB__NAME=taskanline

# --- Секреты (обязательны) ---

# Подпись JWT и токенов приглашений. Минимум 32 символа.
# Сгенерировать: openssl rand -hex 32
SECURITY__SECRET_KEY=change-me-to-a-random-string-at-least-32-chars

# --- Сессии и токены ---

# Время жизни пары токенов. Access живёт минутами и лежит в cookie; refresh
# хранится в БД и отзывается при ротации.
AUTH__ACCESS_TTL_MINUTES=15
AUTH__REFRESH_TTL_DAYS=30

# На продакшене обязательно true. Локально false — чтобы curl и http-клиенты
# без TLS не спотыкались о флаг Secure.
AUTH__COOKIE_SECURE=false
# lax | strict | none. Пара SameSite=Lax + заголовок X-Requested-With закрывает CSRF.
AUTH__COOKIE_SAMESITE=lax
# Пусто — cookie host-only. Заполнять, только если клиент и API на разных поддоменах.
AUTH__COOKIE_DOMAIN=
AUTH__ACCESS_COOKIE_NAME=tkl_access
AUTH__REFRESH_COOKIE_NAME=tkl_refresh

# Защита от перебора: сколько попыток за окно (в секундах) с одного адреса.
AUTH__LOGIN_ATTEMPTS=10
AUTH__LOGIN_WINDOW_SECONDS=60
AUTH__REGISTER_ATTEMPTS=5
AUTH__REGISTER_WINDOW_SECONDS=3600

# --- Приложение ---

# Внешний адрес веб-клиента: база для ссылок в письмах-приглашениях.
APP__PUBLIC_URL=http://localhost:5173

# local | ci | production. В local логи человекочитаемые, в остальных — JSON.
APP__ENVIRONMENT=local

# --- CORS ---

# Списки принимают и строку через запятую, и JSON-массив.
CORS__ORIGINS=http://localhost:5173
CORS__ALLOW_CREDENTIALS=true
CORS__ALLOW_METHODS=*
CORS__ALLOW_HEADERS=*

# --- Сервер ---

SERVER__HOST=0.0.0.0
SERVER__PORT=8000
# Автоперезапуск при правке кода — только для разработки.
SERVER__RELOAD=false

# --- Логи ---

# DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG__LEVEL=INFO

# --- Тесты ---

# Имя тестовой базы: остальные параметры подключения берутся из DB__*.
# Фикстура создаёт её и накатывает миграции сама.
TEST_DB_NAME=taskanline_test

# --- Учётные данные контейнера postgres ---

POSTGRES_USER=taskanline
POSTGRES_PASSWORD=taskanline
POSTGRES_DB=taskanline

# Порт на хосте для docker-compose.dev.yml. Поменять, если 5432 уже занят
# системным PostgreSQL — и не забыть про DB__PORT.
POSTGRES_PORT=5432
