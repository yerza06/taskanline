# Конфигурация TasKanLine. Скопировать в корень как .env и заполнить.
# Все переменные разбирает pydantic-settings (backend/app/core/config.py).
#
# Настройки сгруппированы по областям, и группа задаёт префикс: DB__, SECURITY__,
# APP__, LOG__. Разделитель — два подчёркивания.

# --- Обязательные ---

# Строка подключения к PostgreSQL. Драйвер обязательно asyncpg.
# В docker-compose хост — имя сервиса: postgres
DB__URL=postgresql+asyncpg://taskanline:taskanline@localhost:5432/taskanline

# Подпись JWT и токенов приглашений. Минимум 32 символа.
# Сгенерировать: openssl rand -hex 32
SECURITY__SECRET_KEY=change-me-to-a-random-string-at-least-32-chars

# --- Необязательные ---

# Внешний адрес веб-клиента: база для ссылок в письмах-приглашениях.
APP__PUBLIC_URL=http://localhost:5173

# local | ci | production. В local логи человекочитаемые, в остальных — JSON.
APP__ENVIRONMENT=local

# DEBUG | INFO | WARNING | ERROR
LOG__LEVEL=INFO

# Список через запятую.
APP__CORS_ORIGINS=http://localhost:5173

# --- Тесты ---

# Отдельная база: pytest применяет к ней миграции и катает по ней транзакции.
TEST_DB__URL=postgresql+asyncpg://taskanline:taskanline@localhost:5432/taskanline_test

# --- Учётные данные контейнера postgres ---

POSTGRES_USER=taskanline
POSTGRES_PASSWORD=taskanline
POSTGRES_DB=taskanline

# Порт на хосте для docker-compose.dev.yml. Поменять, если 5432 уже занят
# системным PostgreSQL — и не забыть про порт в DB__URL и TEST_DATABASE_URL.

POSTGRES_PORT=5432
